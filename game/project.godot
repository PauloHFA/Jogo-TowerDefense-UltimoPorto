; Engine configuration file.
; Ultimo Porto: Mares de Ferro - campaign prototype.

config_version=5

[application]

config/name="Ultimo Porto: Mares de Ferro"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1000
window/size/viewport_height=720
window/size/window_width_override=1000
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.09, 0.12, 1)
