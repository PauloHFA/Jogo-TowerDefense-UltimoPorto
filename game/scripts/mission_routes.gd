static func for_mission(mission_id: int) -> Array[Vector2i]:
	var result: Array[Vector2i] = []
	var route := ROUTES[clampi(mission_id - 1, 0, ROUTES.size() - 1)]
	for coordinate in route.split(";"):
		var point := coordinate.split(",")
		result.append(Vector2i(int(point[0]), int(point[1])))
	return result
